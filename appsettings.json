{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MyRefresherWebAPI": "Information",
      "JwtBearerEvents": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "Jwt": {
    "Issuer": "MyRefresherWebAPI",
    "Audience": "MyRefresherWebAPI.Clients",
    "ExpirationMinutes": 60,
    "SigningKey": ""
  },
  "DevelopmentUsers": {
    "Users": []
  },
  "AllowedHosts": "*"
}
